{
  "info": {
    "_postman_id": "tasktracker-collection-v1",
    "name": "Task Tracker API",
    "description": "Complete API collection for the Task Tracker application.\n\n## Quick Start\n1. Import this collection AND `TaskTracker.postman_environment.json`.\n2. Select the **TaskTracker - Local** environment from the dropdown.\n3. Run **Auth → Login (User)** or **Auth → Register** first.\n   The test scripts will automatically capture the CSRF token.\n4. All subsequent requests are ready to use.\n\n## Authentication\nThe API uses HttpOnly cookies for JWT storage. Postman handles cookies automatically. The CSRF token is captured into the `csrfToken` environment variable by the login/register scripts and injected as the `X-CSRF-Token` header via a collection-level pre-request script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Inject the CSRF token header for all state-mutating requests",
          "const method = pm.request.method;",
          "const safeMethods = ['GET', 'HEAD', 'OPTIONS'];",
          "if (!safeMethods.includes(method)) {",
          "    const csrfToken = pm.environment.get('csrfToken');",
          "    if (csrfToken) {",
          "        pm.request.headers.add({ key: 'X-CSRF-Token', value: csrfToken });",
          "    }",
          "}"
        ]
      }
    }
  ],
  "variable": [],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Verify the API server is running."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"success\",\n  \"message\": \"Task Tracker API is running\",\n  \"timestamp\": \"2024-01-01T00:00:00.000Z\",\n  \"environment\": \"development\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Authentication endpoints — register, login, logout, and profile.",
      "item": [
        {
          "name": "Get CSRF Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.data && json.data.csrfToken) {",
                  "        pm.environment.set('csrfToken', json.data.csrfToken);",
                  "        console.log('CSRF token refreshed:', json.data.csrfToken);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/csrf",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "csrf"]
            },
            "description": "Issue/refresh a CSRF token for an existing authenticated session.\n\nReturns `204 No Content` if no session cookie is present. Returns `200` with the new token if already logged in.\n\nCall this on app boot if you already have a session."
          },
          "response": [
            {
              "name": "200 OK (logged in)",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"success\",\n  \"data\": {\n    \"csrfToken\": \"a3f1c...\"\n  }\n}"
            },
            {
              "name": "204 No Content (not logged in)",
              "status": "No Content",
              "code": 204,
              "body": ""
            }
          ]
        },
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    // Extract csrf_token from Set-Cookie header",
                  "    const setCookie = pm.response.headers.get('Set-Cookie') || '';",
                  "    const match = setCookie.match(/csrf_token=([^;]+)/);",
                  "    if (match) {",
                  "        pm.environment.set('csrfToken', match[1]);",
                  "        console.log('CSRF token captured from register:', match[1]);",
                  "    }",
                  "    const json = pm.response.json();",
                  "    if (json.data && json.data.user) {",
                  "        pm.environment.set('userId', json.data.user.id);",
                  "    }",
                  "    pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "    pm.test('Response has user data', () => {",
                  "        pm.expect(json.data.user).to.have.property('id');",
                  "        pm.expect(json.data.user).to.have.property('email');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Smith\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"Password1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Register a new user account.\n\n**Password rules:** min 8 chars, at least one uppercase, one lowercase, one number.\n\nOn success, sets `access_token` (HttpOnly) and `csrf_token` cookies."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"status\": \"success\",\n  \"message\": \"Account created successfully\",\n  \"data\": {\n    \"user\": {\n      \"id\": \"clx...\",\n      \"name\": \"Jane Smith\",\n      \"email\": \"jane@example.com\",\n      \"role\": \"USER\",\n      \"createdAt\": \"2024-01-01T00:00:00.000Z\"\n    }\n  }\n}"
            },
            {
              "name": "400 Validation Error",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"status\": \"fail\",\n  \"message\": \"Validation failed\",\n  \"errors\": [\n    { \"field\": \"password\", \"message\": \"Password must contain at least one uppercase letter, one lowercase letter, and one number\" }\n  ]\n}"
            }
          ]
        },
